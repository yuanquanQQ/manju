# LLM 配置（OpenAI 兼容协议；可指向 3090 GPU 服务器的局域网地址）
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=qwen/qwen3.5-9b
LLM_TIMEOUT=600
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=4096
LLM_CONTEXT_SIZE=8192
# 留空表示不在本机启动 llama.cpp；模型服务可通过 SSH 隧道映射到 LLM_BASE_URL
# LLM_MODEL_PATH=
EXTRACT_MAX_CHARS=6000
EXTRACT_CONCURRENCY=1

# ComfyUI
COMFYUI_URL=localhost:8189
COMFYUI_TIMEOUT=600
# 本地生成模型根目录（模型中心会扫描此目录及其子目录）
LOCAL_AI_ROOT=models/generative

# GPU 服务器（桌面应用会话内输入密码，不建议写入 .env）
GPU_SSH_HOST=
GPU_SSH_PORT=22
GPU_SSH_USER=root

# 数据库与任务恢复
SQLITE_BUSY_TIMEOUT_MS=30000
PIPELINE_STALE_AFTER_SECONDS=300
